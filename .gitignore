# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# env files — never commit secrets
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local
# catch-all for any env file pulled from Vercel or sibling environments
# (e.g. `vercel env pull .env.vercel-check`) — must come after the explicit
# rules above so they still take precedence
.env.vercel*
.env.*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
.vercel
.worktrees/
