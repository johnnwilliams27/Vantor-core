# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Blockchain RPCs
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key

# API Keys
ETHERSCAN_API_KEY=your-etherscan-key
HELIUS_API_KEY=your-helius-key
ONEINCH_API_KEY=your-1inch-key
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-id

# Cron Security
CRON_SECRET=your-cron-secret

# ERP Config
ERP_USE_MOCK=true

# Encryption
CREDENTIALS_ENCRYPTION_KEY=your-32-byte-hex-key

# Chainalysis Compliance (true = mock mode)
CHAINALYSIS_USE_MOCK=true
CHAINALYSIS_SANCTIONS_API_KEY=
CHAINALYSIS_KYT_API_KEY=
CHAINALYSIS_TRAVEL_RULE_API_KEY=
TRAVEL_RULE_THRESHOLD_USD=3000
TRAVEL_RULE_VASP_NAME=Vantor Treasury
