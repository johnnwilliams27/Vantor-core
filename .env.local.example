# =============================================================================
# Integration Mode
# =============================================================================
# Runtime mode is determined per-request by customer tier + test mode toggle:
#   Lite tier         → mock (dummy data, no API calls)
#   Paid + test mode  → sandbox (sandbox API calls)
#   Paid + live mode  → live (live API calls)
#
# Set FORCE_MOCK=true for offline development or CI (overrides all modes to mock)
FORCE_MOCK=false

# =============================================================================
# NextAuth
# =============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Blockchain RPCs
# =============================================================================
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key

# =============================================================================
# API Keys
# =============================================================================
ETHERSCAN_API_KEY=your-etherscan-key
HELIUS_API_KEY=your-helius-key
ONEINCH_API_KEY=your-1inch-key
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-id
ANTHROPIC_API_KEY=

# =============================================================================
# App URL
# =============================================================================
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Cron Security
# =============================================================================
CRON_SECRET=your-cron-secret
ENABLE_CRONS=false
# Comma-separated IPs to allowlist (leave blank to allow all)
ALLOWED_IPS=

# =============================================================================
# ERP / Mock Flags
# =============================================================================
ERP_USE_MOCK=true
COINGECKO_USE_MOCK=true

# =============================================================================
# Encryption
# =============================================================================
CREDENTIALS_ENCRYPTION_KEY=your-32-byte-hex-key

# =============================================================================
# Chainalysis Compliance
# =============================================================================
# Set CHAINALYSIS_USE_MOCK=false in production to enable real API calls
CHAINALYSIS_USE_MOCK=true
CHAINALYSIS_SANCTIONS_API_KEY=
CHAINALYSIS_KYT_API_KEY=
CHAINALYSIS_TRAVEL_RULE_API_KEY=
TRAVEL_RULE_THRESHOLD_USD=3000
TRAVEL_RULE_VASP_NAME=Vantor Treasury

# =============================================================================
# OpenSanctions (Counterparty Screening)
# =============================================================================
# For dev: point at local yente instance (docker run -p 9090:8000 ghcr.io/opensanctions/yente)
# For prod: use https://api.opensanctions.org and set OPENSANCTIONS_USE_MOCK=false
OPENSANCTIONS_API_URL=http://localhost:9090
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_USE_MOCK=true
OPENSANCTIONS_MATCH_THRESHOLD=0.7
OPENSANCTIONS_STALENESS_DAYS=14

# =============================================================================
# Stripe (billing + Financial Connections)
# =============================================================================
# Use sk_test_* keys for sandbox, sk_live_* keys for production
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_STARTER=
STRIPE_PRODUCT_GROWTH=
STRIPE_PRODUCT_SCALE=
STRIPE_PRODUCT_ENTERPRISE=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# =============================================================================
# Persona (KYC / KYB)
# =============================================================================
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
PERSONA_KYC_TEMPLATE_ID=
PERSONA_KYB_TEMPLATE_ID=
PERSONA_ENVIRONMENT_ID=
NEXT_PUBLIC_PERSONA_ENVIRONMENT=sandbox
# Set to "true" to enable KYB gate in upgrade flow
NEXT_PUBLIC_PERSONA_KYB_ENABLED=

# =============================================================================
# Email — Resend
# =============================================================================
RESEND_API_KEY=
# Set RESEND_USE_MOCK=true for local dev (logs emails to console instead of sending)
RESEND_USE_MOCK=true

# =============================================================================
# SMTP (error digest cron)
# =============================================================================
SMTP_USE_MOCK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# =============================================================================
# Sentry (error monitoring)
# =============================================================================
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# Belvo (Brazil / Mexico bank connections)
# =============================================================================
BELVO_SECRET_KEY_ID_SANDBOX=
BELVO_SECRET_KEY_PASSWORD_SANDBOX=
BELVO_SECRET_KEY_ID_LIVE=
BELVO_SECRET_KEY_PASSWORD_LIVE=

# =============================================================================
# Bridge.xyz (stablecoin on/off-ramp)
# =============================================================================
BRIDGE_API_KEY_SANDBOX=
BRIDGE_API_KEY_LIVE=
